# Copie para .env (ou exporte no ambiente) antes de rodar fora de desenvolvimento.

# Obrigatória quando DEBUG=false — o boot falha se estiver ausente.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Servidor
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Banco
DATABASE_PATH=loja.db

# Popular o banco com dados de exemplo no primeiro boot (apenas se estiver vazio)
SEED_ON_BOOT=true
# Senha dos usuários de exemplo. Se ficar vazia, uma senha aleatória é gerada e
# registrada no log durante o seed.
SEED_SENHA_PADRAO=

# Observabilidade
LOG_LEVEL=INFO

# CORS: "*" libera qualquer origem; em produção use a lista explícita
# Ex.: CORS_ORIGINS=https://loja.exemplo.com,https://admin.loja.exemplo.com
CORS_ORIGINS=*
