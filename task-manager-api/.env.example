# Copie para .env antes de rodar fora de desenvolvimento.

# Obrigatória quando DEBUG=false — o boot falha se estiver ausente.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

DEBUG=false
HOST=0.0.0.0
PORT=5000
DATABASE_URL=sqlite:///tasks.db

# Popula o banco com dados de exemplo no boot, só se estiver vazio.
SEED_ON_BOOT=true

# Credenciais de SMTP para NotificationService. Sem default que finja ser
# segredo real — se ausentes, o envio de e-mail é ignorado (best effort) e
# um aviso é logado; não impede o boot da API.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
