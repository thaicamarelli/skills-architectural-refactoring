# Copie este arquivo para ".env" e preencha com os valores reais do ambiente.
# Nunca commitar o ".env" com segredos reais.

PORT=3000

# Credenciais/segredos - nao usar os valores de exemplo em producao
DB_USER=admin_master
DB_PASS=change-me
PAYMENT_GATEWAY_KEY=change-me
SMTP_USER=no-reply@fullcycle.com.br

# Chave usada para proteger endpoints administrativos (financial-report, delete de usuario)
ADMIN_API_KEY=change-me

# Custo do bcrypt (numero de rounds)
BCRYPT_SALT_ROUNDS=12
